PORT=3000
CORS_ORIGIN=*

# Swagger UI at /api/docs is served unless this is `production`
NODE_ENV=development

DATABASE_URL=postgresql://roadrage:roadrage@localhost:5432/roadrage
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# Grid cell size in degrees (0.005 ~ 555m of latitude)
BBOX_CELL_DEG=0.005
# How many last points are kept per device
TAIL_SIZE=5
# A device with no update for this long is not returned / its tail is reset
STALE_SECONDS=30
# Default radius for nearby lookup, metres
NEARBY_RADIUS_M=300
