PORT=3000
CORS_ORIGIN=*

# Swagger UI at /api/docs is served unless this is `production`
NODE_ENV=development

# Postgres and Redis are the shared ones on the server; nothing runs locally.
# Local development uses the same database and Redis db as the dev deployment
DATABASE_URL=postgresql://postgres:change-me@161.97.124.144:5432/roadrage_dev?schema=public
REDIS_URL=redis://:change-me@161.97.124.144:6379/2

# Uploaded files (skin images) live in the shared MinIO on the server;
# there is no local MinIO. The bucket is created on start if missing
MINIO_ENDPOINT=161.97.124.144
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=roadrage-dev

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# Grid cell size in degrees (0.005 ~ 555m of latitude)
BBOX_CELL_DEG=0.005
# How many last points are kept per device
TAIL_SIZE=5
# A device with no update for this long is not returned / its tail is reset
STALE_SECONDS=30
# Default radius for nearby lookup, metres
NEARBY_RADIUS_M=300
